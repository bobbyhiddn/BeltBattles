<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- M1: the window is the page's own dark background. It must be a COLOR: Capacitor's SystemBars plugin reads this
             attribute's value as a colour and paints the decor view with it (SystemBars.java setStyle, getThemeColor). -->
        <item name="android:windowBackground">@color/bb_background</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- M1: the template's drawable/splash.png has a white background, so the launch screen is the page's dark colour instead
             (the 26 template PNGs stay in res/ for M3 to replace with the game's own art). -->
        <item name="android:background">@color/bb_background</item>
        <item name="android:windowBackground">@color/bb_background</item>
        <item name="windowSplashScreenBackground">@color/bb_background</item>
    </style>
</resources>
